# yaml-language-server: $schema=https://raw.githubusercontent.com/oxGrad/knot/main/schema/knotfile.schema.json
# Knotfile — knot dotfiles manager configuration
# Full reference: https://github.com/oxgrad/knot

packages:

  # Neovim configuration
  nvim:
    target: ~/.config/nvim
    ignore:
      - "README.md"
    tags: [code]
    install:
      brew: neovim
      apt: neovim
      dnf: neovim

  tmux:
    target: ~/
    tags: [terminal]

  starship:
    target: ~/.config/
    tags: [terminal]

  kitty:
    target: ~/.config/kitty
    tags: [terminal]

  # Zsh configuration
  zsh:
    target: ~/
    ignore:
      - "README.md"
    tags: [terminal]

  k9s:
    target: ~/.config/k9s
    tags: [kubernetes]
    install:
      brew: derailed/k9s/k9s

  ghostty:
    target: ~/.config/ghostty
    tags: [terminal]
    install:
      autoResolve: true

  # zellij:
  #   target: ~/.config/zellij
  #   tags: [terminal]

  # linux-only: 
  sway:
    target: ~/.config/sway
    tags: [sway]
    condition:
      os: linux

  swaync:
    target: ~/.config/swaync
    tags: [sway]
    condition:
      os: linux

  waybar:
    target: ~/.config/waybar
    tags: [sway]
    condition:
      os: linux

  quickshell:
    target: ~/.config/quickshell
    tags: [sway]
    condition:
      os: linux
    # quickshell isn't in Fedora's default repos — install via COPR
    # (or the appropriate source for your distro) before `knot tie`.

  wlogout:
    target: ~/.config/wlogout
    tags: [sway]
    condition:
      os: linux

  # themes native Qt widgets (e.g. quickshell's tray right-click menu) to
  # match Monokai; quickshell-bar.sh sets QT_QPA_PLATFORMTHEME=qt6ct
  qt6ct:
    target: ~/.config/qt6ct
    tags: [sway]
    condition:
      os: linux
    install:
      dnf: qt6ct

  wofi:
    target: ~/.config/wofi
    tags: [sway]
    condition:
      os: linux

  xdg-desktop-portal-wlr:
    target: ~/.config/xdg-desktop-portal-wlr
    tags: [sway]
    condition:
      os: linux
    install:
      dnf: xdg-desktop-portal-wlr

  flameshot:
    target: ~/.config/flameshot
    tags: [sway, utilities]
    condition:
      os: linux
    install:
      autoResolve: true

  alacritty:
    target: ~/.config/alacritty
    tags: [testing]
    condition:
      os: linux
    install:
      autoResolve: true

  # macOS-only: yabai window manager
  # yabai:
  #   target: ~/.config/yabai
  #   condition:
  #     os: darwin                  # darwin | linux | windows | freebsd
