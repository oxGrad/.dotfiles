[
{
  "layer": "top",
  "position": "top",
  "height": 26,
  "margin": "4 8 2 8",
  "spacing": 0,
  "modules-left": [
    // "custom/launcher",
    "sway/workspaces",
    "custom/swap",
    "sway/mode",
    "custom/cava-internal",
    "mpd#2",
    "mpd#3",
    "mpd#4",
    "mpd"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    // "custom/keyboard-layout",
    // "group/hardware",
    "group/spotify",
    "tray",
    "group/system"
    // "idle_inhibitor",
    // "custom/power"
  ],

  // Load modules
  "include": [
    "~/.config/waybar/modules-left.jsonc",
    "~/.config/waybar/modules-center.jsonc",
    "~/.config/waybar/modules-right.jsonc"
  ]

},

// Lyrics card: a second, click-through bar that floats under the main one
// without reserving space, so windows aren't pushed down. Hidden until
// toggled with $mod+y (sway/config).
{
  "name": "lyrics",
  "layer": "top",
  "position": "top",
  "exclusive": false,
  "passthrough": true,
  // Right margin lines the card up with the spotify pill's right edge.
  // ponytail: fixed offset, re-tune if the tray/system islands change width
  "margin": "0 192 0 8",
  "modules-right": ["custom/lyrics"],
  "custom/lyrics": {
    "exec": "~/.config/waybar/scripts/lyrics.py",
    "return-type": "json",
    "interval": 1,
    "signal": 8,
    "justify": "left"
  }
}
]
